      "SponsoredSuggestions": false,
      "ImproveSuggest": false,
      "Locked": true
    },
    "GenerativeAI": {
      "Enabled": false,
      "Chatbot": false,
      "LinkPreviews": false,
      "TabGroups": false,
      "Locked": true
    },
    "HttpsOnlyMode": "enabled",
    "PasswordManagerEnabled": false,
    "PopupBlocking": {
      "Default": true,
      "Locked": true
    },
    "StartDownloadsInTempDirectory": true,
    "UserMessaging": {
